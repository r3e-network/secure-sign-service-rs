# Production EnvironmentFile for neo-nitro-gateway.service.
# Install as /etc/neo-signer/signer.env (root:neo-signer, 0640).
# Do not put tokens on systemd ExecStart argv or in logs.

SIGNER_PUBLIC_KEY=
SIGNER_LISTEN=10.78.0.1:9991
SIGNER_NETWORK=860833102

# Exactly one identities source. Prefer a 0600 file or systemd LoadCredential.
# GATEWAY_WORKLOAD_IDENTITIES=dBFT-node:consensus:<hex-token>,gas-sweeper:economic:<hex-token>
GATEWAY_WORKLOAD_IDENTITIES_FILE=/etc/neo-signer/workload-identities
# GATEWAY_WORKLOAD_IDENTITIES_FD=3

ENABLE_RAW_PAYLOAD_SIGNING=false
ENABLE_SIGN_TRANSACTION=false
# Danger switch for 0.0.0.0/::, public/global, and wide CIDRs (/1, /8, IPv4</16, IPv6</64).
# GATEWAY_ALLOW_WILDCARD_BIND=false
# GATEWAY_ALLOW_BIND_CIDR=192.168.10.0/24
