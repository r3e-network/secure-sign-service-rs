[Unit]
Description=Daily fallback schedule for the Neo N3 council GAS sweep

[Timer]
# Explicit timezone keeps the schedule stable if the host timezone changes.
OnCalendar=*-*-* 09:05:00 Asia/Shanghai
RandomizedDelaySec=300
Persistent=true
AccuracySec=1min
Unit=neo-gas-sweep.service

[Install]
WantedBy=timers.target
