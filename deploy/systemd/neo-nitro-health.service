[Unit]
Description=Check and recover the Neo council Nitro signer
After=neo-nitro-signer.target

[Service]
Type=oneshot
EnvironmentFile=/etc/neo-signer/signer.env
ExecStart=/opt/neo-signer/bin/health-check.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_VSOCK

