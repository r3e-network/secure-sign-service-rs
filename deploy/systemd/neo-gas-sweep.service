[Unit]
Description=Allowlisted daily Neo N3 council GAS sweep
Requires=neo-nitro-gateway.service
After=neo-nitro-gateway.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
User=neo-signer
Group=neo-signer
EnvironmentFile=/etc/neo-signer/signer.env
ExecStart=/opt/neo-signer/bin/secure-sign-sweeper --broadcast
TimeoutStartSec=180
Restart=on-failure
RestartSec=20
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/neo-signer
MemoryMax=160M
CPUQuota=35%
TasksMax=96
